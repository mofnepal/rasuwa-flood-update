# ── Database ────────────────────────────────────────────────────────────────
# docker compose provides this host name; for local development run
# `pnpm db:local` and use the localhost URL below.
DATABASE_URL="postgresql://rasuwa:rasuwa@postgres:5432/rasuwa_flood?schema=public"
# DATABASE_URL="postgresql://rasuwa:rasuwa@localhost:55432/rasuwa_flood?schema=public"
POSTGRES_USER=rasuwa
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=rasuwa_flood

# ── Auth.js ─────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET="change-me-a-32-byte-random-string"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="https://mof.gov.np/rasuwa-flood"

# Password given to the four seeded accounts. There is no default: seeding
# refuses to run without one of at least 12 characters. Generate it with
#   openssl rand -base64 24
# then change each account's password from /admin/users on first sign-in.
SEED_PASSWORD=""

# ── File storage ────────────────────────────────────────────────────────────
# local | s3   (s3 talks to the MinIO service in docker-compose.yml)
STORAGE_DRIVER=local
UPLOAD_DIR=/data/uploads
UPLOAD_PUBLIC_PREFIX=/rasuwa-flood/uploads
S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_URL="/rasuwa-flood/uploads"
S3_BUCKET=rasuwa-flood
S3_REGION=us-east-1
S3_ACCESS_KEY=rasuwa
S3_SECRET_KEY=change-me-in-production

# ── Contact form ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM="rasuwa-flood@mof.gov.np"
CONTACT_TO="fmo@mof.gov.np"

# ── Public site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://mof.gov.np/rasuwa-flood"
